rules_version = '2';

// Reglas de seguridad: son el "backend" del portafolio (plan Spark, sin servidor).
//  - Cualquiera puede LEER el contenido público (perfil, proyectos, etc.).
//  - Solo el administrador puede ESCRIBIR. Es administrador quien tenga un
//    documento admins/{su UID}; ese documento se crea a mano en la consola
//    de Firebase y nadie puede crearlo desde la web.
//  - Cualquiera puede ENVIAR un mensaje de contacto (solo crear, con límites);
//    solo el administrador puede leerlos o borrarlos.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Lista de administradores: cada uno solo puede ver su propio documento.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Perfil y configuración del sitio.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Secciones del portafolio.
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experience/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /skills/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /certifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /education/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Formulario de contacto.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'read'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && isStr(request.resource.data.name, 1, 100)
        && isStr(request.resource.data.email, 5, 150)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && isStr(request.resource.data.message, 5, 3000)
        && request.resource.data.createdAt == request.time
        && (!('read' in request.resource.data) || request.resource.data.read == false);
      allow read, update, delete: if isAdmin();
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
